# Copiar a .env y completar
DUFFEL_API_URL=https://api.duffel.com
DUFFEL_API_TOKEN=duffel_test_xxx
# Semilla de la ganancia determinística (app/core/pricing). Usar un valor largo y aleatorio.
PRICING_SECRET=change-me
# Claves que firman los access tokens (JSON con JWKs EC P-256). Generar con `make auth-keygen`.
AUTH_SIGNING_KEYS=
# Cifra los client secrets de los proveedores de identidad. Generar con `make auth-keygen`.
IDENTITY_SECRETS_KEY=
